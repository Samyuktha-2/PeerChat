<Window x:Class="PeerChat.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PeerChat"
        Title="PeerChat"
        Height="720"
        Width="920"
        MinHeight="560"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="BubbleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="8 5" />
            <Setter Property="MaxWidth" Value="430" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="System">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="MaxWidth" Value="700" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource CardBrush}">
            <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesItemsControl" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Style="{StaticResource BubbleBorderStyle}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BubbleBorderStyle}">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="System">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0 0 0 4" />

                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="System">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Click="ImagePreview_Click"
                                                CommandParameter="{Binding}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Padding="0"
                                                HorizontalAlignment="Left">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Image">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6">
                                                <Image Source="{Binding Image}"
                                                       MaxWidth="320"
                                                       Stretch="Uniform" />
                                            </Border>
                                        </Button>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Video">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Height="12"
                                                         Margin="0 8 0 0"
                                                         Value="{Binding Progress}"
                                                         Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="Play video"
                                                    Width="120"
                                                    Height="32"
                                                    Margin="0 10 0 0"
                                                    HorizontalAlignment="Left"
                                                    Click="PlayVideo_Click"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="TypingTextBlock"
                   Grid.Row="1"
                   Text="Peer is typing..."
                   Visibility="Collapsed"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="6 8 6 4" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <Button x:Name="ImageButton"
                        Content="Image"
                        Width="74"
                        Height="38"
                        Margin="0 0 8 0"
                        DockPanel.Dock="Left"
                        Click="ImageButton_Click" />
                <Button x:Name="VideoButton"
                        Content="Video"
                        Width="74"
                        Height="38"
                        Margin="0 0 8 0"
                        DockPanel.Dock="Left"
                        Click="VideoButton_Click" />
                <Button x:Name="SendButton"
                        Content="Send"
                        Width="82"
                        Height="38"
                        Margin="8 0 0 0"
                        DockPanel.Dock="Right"
                        Click="SendButton_Click" />
                <TextBox x:Name="MessageTextBox"
                         MinHeight="38"
                         Padding="10"
                         AcceptsReturn="False"
                         TextChanged="MessageTextBox_TextChanged"
                         KeyDown="MessageTextBox_KeyDown"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0" />
            </DockPanel>

            <Expander Grid.Row="1"
                      Margin="0 12 0 0"
                      Header="Debug Log"
                      Foreground="{DynamicResource TextPrimaryBrush}">
                <ListBox x:Name="DebugLogListBox"
                         ItemsSource="{Binding DebugLog}"
                         DisplayMemberPath="Display"
                         Height="120"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Expander>
        </Grid>
    </Grid>
</Window>
