<Window x:Class="PeerChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:PeerChat.View" 
        xmlns:viewmodel="clr-namespace:PeerChat.ViewModel" 
        xmlns:helpers="clr-namespace:PeerChat.Helpers"
        xmlns:viewmodel1="clr-namespace:peerchat.viewmodel"
        Title="PeerChat - Connect"
        Height="800"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        WindowState="Maximized">
    <Window.DataContext>
        <viewmodel1:MainVM />
    </Window.DataContext>
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <ContentControl Content="{Binding CurrentView}"/>
        
        
    </Grid>

</Window>
