<Window x:Class="PeerChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:PeerChat.View" 
        xmlns:viewmodel="clr-namespace:PeerChat.ViewModel" 
        xmlns:helpers="clr-namespace:PeerChat.Helpers"
        Title="PeerChat - Connect"
        Height="560"
        Width="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Window.DataContext>
        <viewmodel:MainVM />
    </Window.DataContext>
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <ContentControl Content="{Binding CurrentView}"/>
        <Button VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="50"
                Height="30"
                Foreground="White"
                FontSize="15"
                Margin="10"
                Command="{Binding ThemeCommand}"
                Content="Theme" Background="{DynamicResource PrimaryBrush}"/>
        <!--<view:ConnectionWindow VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
    </Grid>

</Window>
