<Window x:Class="PeerChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PeerChat"
        xmlns:view="clr-namespace:PeerChat.View"
        xmlns:viewmodel="clr-namespace:PeerChat.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <viewmodel:MainVM /> 
    </Window.DataContext>
    <Grid>
        <view:ConnectionWindow VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Window>
