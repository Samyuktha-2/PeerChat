<Application x:Class="PeerChat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PeerChat" xmlns:viewmodel="clr-namespace:PeerChat.ViewModel" xmlns:view="clr-namespace:PeerChat.View"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewmodel:ChatWindowVM}">
                <view:ChatWindow />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodel:ConnectionWindowVM}">
                <view:ConnectionWindow />
            </DataTemplate> 
            
        </ResourceDictionary>  
    </Application.Resources>
</Application>
