<UserControl x:Class="PeerChat.View.ChatWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PeerChat.View"
             xmlns:helpers="clr-namespace:PeerChat.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    
    <UserControl.Resources>

        <Style x:Key="IconButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="40" />
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="{DynamicResource SecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding"
                    Value="8" />
            <Setter Property="BorderThickness"
                    Value="2" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="20"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AttachmentItemStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="10"
                                Background="Transparent">

                            <ContentPresenter Margin="5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="{DynamicResource CardBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5.167" />
            <ColumnDefinition Width="84.833" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Background="{DynamicResource AccentBrush}"
              Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Margin="10"
                    Height="35"
                    Style="{StaticResource IconButtonStyle}">
                <Image Source="/Images/conversation.png"
                       Width="20"
                       Height="20" />
            </Button>

            <Grid Grid.Row="2">
                <Button x:Name="ProfileBtn"
                        Margin="10"
                        Style="{DynamicResource IconButtonStyle}"
                        Command="{Binding ProfileClickCommand}"
                        Height="35">
                    <Image Source="/Images/user.png"
                           Width="30"
                           Height="20" />
                </Button>
                <Popup IsOpen="{Binding IsProfileMenuOpen}"
                       PlacementTarget="{Binding ElementName=ProfileBtn}"
                       Placement="Top"
                       AllowsTransparency="True"
                       StaysOpen="False">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="15"
                            Padding="10">
                        <StackPanel>
                            <Button Style="{StaticResource AttachmentItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤"
                                               Margin="5" />
                                    <TextBlock Text="{Binding MyName}"
                                               Margin="0 5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AttachmentItemStyle}"
                                    Command="{Binding ThemeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖌️"
                                               Margin="5" />
                                    <TextBlock Text="Theme"
                                               Margin="0 5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AttachmentItemStyle}"
                                    Command="{Binding LogoutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➡️"
                                               Margin="5" />
                                    <TextBlock Text="Logout"
                                               Margin="0 5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Row="3"
                        Background="{DynamicResource SurfaceBrush}"
                        Orientation="Horizontal">
                <CheckBox Content="DebugLog"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Margin="5"
                          IsChecked="{Binding IsDebugEnabled}" />
            </StackPanel>
        </Grid>
        
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedUserName}"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Margin="10 1 0 0"
                                 Height="10">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PeerStatus}"
                                                     Value="Online">
                                            <Setter Property="Fill"
                                                    Value="Green" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PeerStatus}"
                                                     Value="Offline">
                                            <Setter Property="Fill"
                                                    Value="Red" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding PeerStatus}"
                                   FontSize="14" Margin="2 0 0 0"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            Margin="5"
                                            CornerRadius="12"
                                            MaxWidth="300">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource CardBrush}" />
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSentByMe}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="HorizontalAlignment"
                                                                Value="Right" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment"
                                                                Value="Left" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSystemMessage}"
                                                                         Value="True">
                                                                <Setter Property="HorizontalAlignment"
                                                                        Value="Center" />
                                                                <Setter Property="Foreground"
                                                                        Value="Gray" />
                                                                <Setter Property="FontStyle"
                                                                        Value="Italic" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border MaxWidth="320"
                                                    Margin="5"
                                                    Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Image Source="{Binding Image}"
                                                           Stretch="Uniform"
                                                           Cursor="Hand"
                                                           MouseLeftButtonDown="Image_Click" />
                                                </StackPanel>
                                            </Border>

                                            <!--<local:VideoView />-->
                                            <Border MaxWidth="340"
                                                    Margin="8"
                                                    Padding="8"
                                                    CornerRadius="18"
                                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{DynamicResource CardBrush}">

                                                <StackPanel>

                                                    <DockPanel Margin="2 0 2 8">

                                                        <TextBlock Text="🎬"
                                                                   FontSize="16"
                                                                   Margin="0 0 6 0"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" />

                                                    </DockPanel>

                                                    <Border Padding="10"
                                                            CornerRadius="12"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            Visibility="{Binding IsTransferCompleted,Converter={StaticResource InverseBoolToVisibilityConverter}}">

                                                        <StackPanel>
                                                            <TextBlock Text="Receiving Video..."
                                                                       FontSize="12"
                                                                       Margin="0 0 0 8"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <ProgressBar Height="10"
                                                                         Minimum="0"
                                                                         Maximum="100"
                                                                         Value="{Binding TransferProgress}"
                                                                         BorderThickness="0"
                                                                         Background="#22000000"
                                                                         Foreground="{DynamicResource PrimaryBrush}"
                                                                         Margin="0 0 0 6" />
                                                            <DockPanel>

                                                                <TextBlock Text="{Binding TransferProgress,StringFormat={}{0:F0}%}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                                                                <TextBlock Text="{Binding TransferStatus}"
                                                                           FontSize="11"
                                                                           HorizontalAlignment="Right"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Grid Width="280"
                                                          Height="180"
                                                          Margin="0 5 0 0"
                                                          Visibility="{Binding IsTransferCompleted,Converter={StaticResource BoolToVisibilityConverter}}">

                                                        <Border CornerRadius="16"
                                                                ClipToBounds="True"
                                                                Background="Black">
                                                            <Grid>
                                                                <Image Source="{Binding VideoThumbnail}"
                                                                       Stretch="UniformToFill" />
                                                                <Rectangle VerticalAlignment="Bottom"
                                                                           Height="60">
                                                                    <Rectangle.Fill>
                                                                        <LinearGradientBrush StartPoint="0,0"
                                                                                             EndPoint="0,1">
                                                                            <GradientStop Color="#00000000"
                                                                                          Offset="0" />
                                                                            <GradientStop Color="#AA000000"
                                                                                          Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Rectangle.Fill>
                                                                </Rectangle>
                                                            </Grid>
                                                        </Border>

                                                        <Button Style="{StaticResource IconButtonStyle}"
                                                                Cursor="Hand"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.PlayVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Image Source="/Images/PlayButton.png"
                                                                   Width="25" />
                                                        </Button>

                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding GetDateTime, StringFormat='{}{0:hh:mm tt}'}"
                                                       VerticalAlignment="Bottom"
                                                       FontStyle="Italic"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>

                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Peer is typing..."
                                   Visibility="{Binding IsPeerTyping, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Foreground="Gray"
                                   Margin="10"
                                   FontStyle="Italic" />

                    </StackPanel>
                </ScrollViewer>

                <Border Visibility="{Binding ImagePreview, Converter={StaticResource NullToVisibilityConverter}}"
                        Background="#80000000"
                        CornerRadius="10"
                        Margin="20"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="10">

                    <StackPanel>
                        <Image Source="{Binding ImagePreview}"
                               Width="300"
                               Height="300"
                               Stretch="Uniform"
                               Margin="5" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Discard"
                                    Command="{Binding ClearPreviewCommand}"
                                    Margin="5 0 0 5"
                                    Width="100"
                                    HorizontalAlignment="Left" />
                            <Button Grid.Column="2"
                                    Margin="150 0 0 5"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding SendCommand}">
                                <Image Source="/Images/send.png"
                                       Width="20"
                                       Height="20" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2">
                <Grid Margin="10"
                      Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="{DynamicResource SurfaceBrush}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Button x:Name="AttachBtn"
                                Margin="5"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ShowAttachmentMenuCommand}">
                            <Image Source="/Images/AttachmentIcon.png"
                                   Width="20"
                                   Height="20" />
                        </Button>

                        <Popup IsOpen="{Binding IsAttachmentMenuOpen}"
                               PlacementTarget="{Binding ElementName=AttachBtn}"
                               Placement="Top"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="15"
                                    Padding="10">

                                <StackPanel>  
                                    <Button Style="{StaticResource AttachmentItemStyle}"
                                            Command="{Binding DataContext.ImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖼️"
                                                       Margin="5" />
                                            <TextBlock Text="Images" Margin="0 5"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource AttachmentItemStyle}"
                                            Command="{Binding VideoCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖼️"
                                                       Margin="5" />
                                            <TextBlock Text="Video" Margin="0 5" />
                                        </StackPanel>
                                    </Button>

                                </StackPanel>

                            </Border>
                        </Popup>
                    </Grid>
 
                    <TextBox Grid.Column="1"
                             Margin="5"
                             Text="{Binding OutGoingMessage, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             LostFocus="MessageBox_LostFocus"
                             CaretBrush="{DynamicResource TextSecondaryBrush}"
                             Background="Transparent"
                             VerticalAlignment="Top"
                             MinHeight="30">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
 
                    <Button Grid.Column="2"
                            Margin="5"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding SendCommand}">
                        <Image Source="/Images/send.png"
                               Width="20"
                               Height="20" />
                    </Button>

                </Grid> 
                
                <Grid Visibility="{Binding IsDebugEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Debug Log"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="5" />
                    <ScrollViewer  Grid.Row="1">
                        <ListBox ItemsSource="{Binding DebugLogs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock FontWeight="Bold"> 
                                            <Run Text="{Binding GetDateTime}" />
                                            <Run Text="| " />
                                            <Run Text="{Binding Direction}" />
                                            <Run Text="| " />
                                            <Run Text="{Binding ContentType}" />
                                            <Run Text="| " />
                                            <Run Text="{Binding ContentSize}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </ScrollViewer>
                </Grid>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
