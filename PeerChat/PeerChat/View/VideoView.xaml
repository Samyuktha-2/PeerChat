<UserControl x:Class="PeerChat.View.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PeerChat.View" xmlns:local1="clr-namespace:PeerChat.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local1:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local1:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Border Width="300"
            Margin="8"
            Padding="10"
            CornerRadius="16"
            Background="{DynamicResource CardBrush}">

        <StackPanel>

            <!-- VIDEO FILE NAME -->
            <TextBlock Text="{Binding FileName}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <StackPanel VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="220">

                <TextBlock Text="Receiving Video..."
               HorizontalAlignment="Center"
               Margin="0 0 0 10"
               FontWeight="SemiBold"
               Foreground="White"/>

                <ProgressBar Height="12"
                 Minimum="0"
                 Maximum="100"
                 Value="{Binding TransferProgress}"
                 Background="#44FFFFFF"
                 Foreground="{DynamicResource PrimaryBrush}"/>

                <TextBlock Text="{Binding TransferProgress,
                              StringFormat={}{0:F0}%}"
               HorizontalAlignment="Center"
               Margin="0 8 0 0"
               Foreground="White"/>
            </StackPanel>

            <!-- VIDEO FRAME -->
            <Grid Margin="0 10 0 0"
                  Width="280"
                  Height="170">

                <!-- THUMBNAIL / COVER -->
                <Border CornerRadius="12"
                        Background="{DynamicResource SecondaryBrush}"
                        ClipToBounds="True">

                    <!-- STATIC VIDEO PLACEHOLDER -->
                    <Image Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"/>
                </Border>

                <!-- DARK OVERLAY -->
                <Border CornerRadius="12"
                        Background="#55000000"/>

                <!-- PROGRESS BAR -->
                <Grid Visibility="{Binding IsTransferCompleted,
                                           Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <Border Background="#66000000"
                            CornerRadius="12"/>
                </Grid>

                <!-- PLAY BUTTON -->
                <Button Width="64"
                        Height="64"
                        Visibility="{Binding IsTransferCompleted,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PrimaryBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding PlayVideoCommand}"
                        CommandParameter="{Binding}">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="32">

                                <Viewbox Width="20"
                                         Height="20">

                                    <Path Fill="White"
                                          Data="M 0 0 L 12 6 L 0 12 Z"/>

                                </Viewbox>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>

            <!-- FILE SIZE -->
            <TextBlock Text="{Binding ContentSize}"
                       Margin="0 8 0 0"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- TIME -->
            <TextBlock Text="{Binding GetDateTime,
                                      StringFormat={}{0:hh:mm tt}}"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       Margin="0 5 0 0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

        </StackPanel>
    </Border>
</UserControl>
